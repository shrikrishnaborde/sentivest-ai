# ============================================================
# SentiVest AI — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ============================================================

# --- App ---
APP_ENV=development                # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentivest
POSTGRES_PASSWORD=sentivest
POSTGRES_DB=sentivest
DATABASE_URL=postgresql+asyncpg://sentivest:sentivest@localhost:5432/sentivest

# --- Vector Database ---
VECTOR_STORE_PROVIDER=chroma       # chroma | pinecone | qdrant
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=sentivest_documents

PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=sentivest-documents

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sentivest_documents

# --- LLM Provider ---
LLM_PROVIDER=openai                # openai | azure_openai | anthropic
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

ANTHROPIC_API_KEY=

# --- Sentiment Model ---
FINBERT_MODEL_NAME=ProsusAI/finbert
SENTIMENT_DEVICE=cpu               # cpu | cuda

# --- Redis / Celery (async ingestion jobs) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Data Source APIs ---
# claude_search: Claude searches the web directly (server-side web_search
#   tool) for news — only ANTHROPIC_API_KEY above is required.
# newsapi: use the traditional NewsSourceAdapter (newsapi.org) instead.
NEWS_SOURCE_PROVIDER=claude_search # claude_search | newsapi
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
SEC_EDGAR_USER_AGENT="SentiVest AI contact@sentivest.ai"

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
